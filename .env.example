# ============================================================
# stockmate —— 本地开发环境变量模板
# 使用方式：复制本文件为 .env 并填写真实配置
#   cp .env.example .env
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
# Docker Compose 环境使用 postgres 作为服务名；本机直接开发可改为 localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockmate
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/stockmate

# ── Redis ───────────────────────────────────────────────────
# Docker Compose 环境下
REDIS_URL=redis://redis:6379/0
# 本地直接开发时使用
# REDIS_URL=redis://localhost:6379/0

# ---- Lightweight LangGraph agent runtime ----
# Optional dedicated checkpoint database; empty means DATABASE_URL is reused.
LANGGRAPH_DATABASE_URL=
AGENT_RUN_POLL_SECONDS=0.5
AGENT_RUN_LEASE_SECONDS=120
AGENT_EVENT_STREAM_TTL_SECONDS=86400
AGENT_EVENT_STREAM_MAXLEN=10000
AGENT_STREAM_BLOCK_MS=10000
AGENT_SNAPSHOT_INTERVAL_SECONDS=0.5

# ── AI 模型配置 ──────────────────────────────────────────────
# API 密钥（必填）
AI_API_KEY=your_api_key_here

# API 基础 URL
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
# Ollama本地: http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# 用户级 AI 模型配置 API Key 加密密钥
# 建议使用 32 字节随机值的 base64 编码，例如：
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AI_MODEL_CONFIG_ENCRYPTION_KEY=replace_with_base64_32_bytes_key
AI_MODEL_CONFIG_ENCRYPTION_KEY_ID=default
AI_MODEL_CONFIG_ALLOW_HTTP_BASE_URL=false
AI_MODEL_CONFIG_ALLOW_PRIVATE_BASE_URL=false
AI_MODEL_CONFIG_TEST_TIMEOUT_SECONDS=30

# 模型名称
# OpenAI: gpt-4o, gpt-4o-mini
# DeepSeek: deepseek-chat
# Ollama: llama3.2, qwen2.5
AI_MODEL_NAME=gpt-4o

# Embedding 模型配置（OpenAI 兼容 /v1/embeddings 接口）
# bge-m3 通常为 1024 维，需与 rag_chunk_embeddings.embedding_vector 的 VECTOR(1024) 保持一致
AI_EMBEDDING_API_KEY=your_embedding_api_key_here
AI_EMBEDDING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
AI_EMBEDDING_DIM=1024
AI_EMBEDDING_BATCH_SIZE=10
AI_EMBEDDING_REQUEST_DIMENSIONS=1024
AI_EMBEDDING_TIMEOUT_SECONDS=60
AI_EMBEDDING_MAX_RETRIES=3
AI_EMBEDDING_RETRY_BASE_SECONDS=2.0

# RAG 新闻流水线配置
# 新闻定时任务有新增数据时，自动执行 新闻同步 -> 切片 -> 向量化
RAG_PIPELINE_ON_NEWS_CRAWL=true
RAG_PIPELINE_MIN_INTERVAL_SECONDS=60
RAG_RECONCILE_INTERVAL_SECONDS=300
NEWS_CRAWL_INTERVAL_SECONDS=60
RAG_PIPELINE_DRAIN_MAX_BATCHES=5
RAG_PIPELINE_DRAIN_MAX_SECONDS=180
RAG_PIPELINE_NEWS_LIMIT=100
RAG_PIPELINE_CHUNK_LIMIT=100
RAG_PIPELINE_EMBED_LIMIT=100
RAG_PIPELINE_MAX_CHARS=800
RAG_PIPELINE_OVERLAP_CHARS=120

# ── 应用基本配置 ─────────────────────────────────────────────
DEBUG=true
APP_NAME=stockmate
SECRET_KEY=your-secret-key-here-change-in-production

# 日志同时输出到 stdout 和 LOG_DIR，并按天轮转清理。
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_COLOR=true
LOG_TIMEZONE=Asia/Shanghai
LOG_TO_FILE=true
LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_LEVEL_OVERRIDES_STR=apscheduler=WARNING,httpx=WARNING,httpcore=WARNING
ACCESS_LOG_ENABLED=true
ACCESS_LOG_LEVEL=INFO
# 逗号分隔；默认不记录高频健康检查的成功访问日志，失败仍会记录。
ACCESS_LOG_EXCLUDE_PATHS_STR=/health

# ── CORS 跨域配置 ────────────────────────────────────────────
# 多个来源用逗号分隔
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Tushare Token（可选，用于获取基础数据） ─────────────────────
TUSHARE_TOKEN=your_tushare_token_here
