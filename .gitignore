# ============================================================
# go-stock-python .gitignore
# Python + Node.js + Docker + IDE
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/

# 虚拟环境
.venv/
venv/
ENV/
env/
.env.local
.env.*.local

# 类型检查
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# pytest
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints
*.ipynb

# ── 环境变量（敏感信息，绝对不提交）────────────────────────
.env
!.env.example

# ── 数据库文件 ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# Alembic 自动生成（如果不纳入版本管理）
# backend/alembic/versions/*.py

# ── Node.js / 前端 ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# 构建产物
frontend/dist/
frontend/build/
.vite/

# TypeScript
*.tsbuildinfo

# ── Docker ───────────────────────────────────────────────────
# Docker 运行时数据（本地卷映射）
docker-data/
.docker/

# ── 日志 ─────────────────────────────────────────────────────
logs/
*.log
*.log.*
log/

# ── 临时文件 ─────────────────────────────────────────────────
tmp/
temp/
.tmp/
*.tmp
*.bak
*.swp
*.swo
*~

# ── IDE / 编辑器 ─────────────────────────────────────────────
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Vim
*.vim

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ── Playwright ────────────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/

# ── 其他 ─────────────────────────────────────────────────────
# 上传文件
uploads/
media/

# 证书
*.pem
*.key
*.crt
*.p12

# 备份文件
*.bak
*.backup
/docs/
/backend/tests/
/outputs/
/.trae/
/.agent/